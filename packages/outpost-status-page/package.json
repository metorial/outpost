{
  "name": "@metorial-outpost/status-page",
  "version": "0.1.1",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "author": "Metorial",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsup && vite build",
    "test": "vitest run --passWithNoTests",
    "lint": "prettier src/**/*.{ts,tsx} --check"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@metorial-outpost/proxy": "0.1.1"
  },
  "devDependencies": {
    "@metorial-outpost/tsconfig": "0.1.0",
    "@types/bun": "latest",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "^3.2.7",
    "tsup": "^7.2.0"
  }
}
